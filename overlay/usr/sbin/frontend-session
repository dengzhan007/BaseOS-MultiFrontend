#!/bin/sh
# The frontend session, respawned by busybox init. Replaces the whole stock
# chain (launcher.service -> launcher.sh -> loadapp.sh -> dmenu_ln -> boot
# shim). Runs NextUI, Slot, spruceOS or a generic frontend from the card.

# Export release metadata for installers and every frontend entry point.
if [ -r /etc/baseos-release ]; then
	set -a
	. /etc/baseos-release
	set +a
fi

SD=/mnt/sdcard
. /usr/share/baseos/boot-log.sh
select_boot_log
INSTALL_FAILED=0
CARD_MISSING=0

# One persistent marker is the entire steady-state migration cost: a shell
# builtin, no spawned helper, firmware reads, hashes or backup checks. A fresh
# image records its already-optimised state once. Maintenance boots never write
# disks owned by the USB host. Keep this before update-trial confirmation.
# The marker is boot-pair-v2: a card that finished the earlier gzip migration
# (boot-gzip-v1) runs the helper once more to receive the faster pair.
# The native loader has one marker per generation, named after it.
boot_steps_done=1
[ -e /data/boot-pair-v2/complete ] || boot_steps_done=0
if [ -r /usr/share/baseos/native/generation ]; then
	read -r native_generation < /usr/share/baseos/native/generation || native_generation=
	[ -e "/data/boot-native-v1/done-$native_generation" ] || boot_steps_done=0
fi
if [ "$boot_steps_done" = 0 ] && [ ! -s /run/usb-storage-device ] \
	&& [ -x /usr/sbin/baseos-boot-migrate ]; then
	if ! BASEOS_BOOT_LOG="$LOG" /usr/sbin/baseos-boot-migrate; then
		# Failure with an unverified restore must not trigger a reboot or trial
		# confirmation. ADB started by rcS stays available for recovery.
		while :; do sleep 3600; done
	fi
fi

# A frontend session starting is what ends a system-update trial: the OS came
# up far enough to hand off. Keying it here rather than on the frontend exec is
# deliberate — a card with no frontend is a perfectly healthy OS, and keying it
# later would make that state look like a failed update and roll back forever.
# An OS without its dynamic loader is not healthy, whatever is on the card: the
# /usr/lib image did not mount, and only the rollback can repair that.
[ -x /usr/sbin/baseos-update ] && [ -e /lib/ld-linux-aarch64.so.1 ] \
	&& /usr/sbin/baseos-update confirm 2>/dev/null

# 1.236 -> 1.24: two decimals are plenty for a person reading the log.
seconds() {
	sec_whole=${1%%.*} sec_part=
	[ "$sec_whole" = "$1" ] || sec_part=${1#*.}
	sec_part=${sec_part}000
	sec_part=${sec_part%"${sec_part#???}"}
	sec_cs=$(( (${sec_whole:-0} * 1000 + 1$sec_part - 1000 + 5) / 10 ))
	printf '%d.%02d' $((sec_cs / 100)) $((sec_cs % 100))
}

# Which loader started this boot, and a diagnostics block when it is useful:
# read only, at the lowest priority, once per boot, after the menu is up.
start_diagnostics() {
	[ -x /usr/sbin/baseos-diag ] && [ ! -e /run/baseos-diag-boot ] || return 0
	BASEOS_BOOT_LOG="$LOG" nice -n 19 ionice -c 3 /usr/sbin/baseos-diag --boot \
		</dev/null >/dev/null 2>&1 &
}

important_splash() {
	[ -x /usr/bin/baseos-splash ] \
		&& /usr/bin/baseos-splash --important "$@" 2>/dev/null
}

# rcS has kept the selected device unmounted and handed it to the USB gadget.
# Never race the host by mounting it or starting a frontend.
# The host owns the volume until the next reboot; the static message names the
# critical safety action without adding animation or a resident UI.
if [ -s /run/usb-storage-device ]; then
	log "USB storage mode — frontend intentionally stopped"
	important_splash -1 "STARTING USB STORAGE"
	storage_wait=0
	while [ ! -e /run/usb-storage-ready ] \
		&& [ ! -e /run/usb-storage-failed ] \
		&& [ "$storage_wait" -lt 30 ]; do
		sleep 1
		storage_wait=$((storage_wait + 1))
	done
	if [ -e /run/usb-storage-ready ]; then
		important_splash -1 "USB STORAGE: EJECT BEFORE RESTART"
	else
		log "USB storage gadget did not become ready"
		important_splash -1 "USB STORAGE FAILED: POWER OFF"
	fi
	while :; do sleep 3600; done
fi

# The card should already be mounted by rcS; retry here covers slow cards
# and hot re-insertion after an unmount.
n=0
while ! mountpoint -q "$SD" 2>/dev/null; do
	if [ "$n" -ge 15 ]; then
		log "no card mounted after ${n}s"
		important_splash -1 "INSERT SD CARD"
		CARD_MISSING=1
		break
	fi
	for dev in /dev/mmcblk1p1 /dev/mmcblk0p7; do
		[ -b "$dev" ] || continue
		mount -t vfat -o rw,utf8,noatime,shortname=mixed "$dev" "$SD" 2>/dev/null && break
		mount -t auto -o noatime "$dev" "$SD" 2>/dev/null && break
	done
	mountpoint -q "$SD" 2>/dev/null && break
	sleep 1
	n=$((n + 1))
done

# Update flow: same triggers as the old boot shim (02-boot-and-installer.md).
if mountpoint -q "$SD" 2>/dev/null; then
	select_boot_log
	flush_early_boot_log
	ZIP="$SD/MinUI.zip"
	LAUNCH="$SD/.system/h700/paks/MinUI.pak/launch.sh"
	HAVE_PAKZ=0
	for z in "$SD"/*.pakz; do [ -f "$z" ] && HAVE_PAKZ=1 && break; done
	if [ -f "$ZIP" ] || [ "$HAVE_PAKZ" = 1 ]; then
		# NextUI's installer can't draw its own UI on base OS: its show2.elf
		# needs libSDL2/_image/_ttf, which base OS doesn't ship in /usr/lib (the
		# stock OS did) and NextUI's own SDL2 isn't extracted yet when it runs.
		# So paint one static install/update pill and let the (~1 min) work run
		# under it. Deliberately NOT animated: a background draw loop raced
		# NextUI's first frame and left the splash stuck over its static menu.
		if [ -f "$LAUNCH" ]; then
			important_splash 85 "UPDATING FRONTEND"
		else
			important_splash 85 "INSTALLING FRONTEND"
		fi
		if [ ! -f "$SD/.tmp_update/h700.sh" ] && [ -f "$ZIP" ]; then
			log "bootstrapping installer from MinUI.zip"
			unzip -o "$ZIP" ".tmp_update/*" -d "$SD" >> "$LOG" 2>&1
			log "bootstrap unzip exited $?"
		fi
		if [ -f "$SD/.tmp_update/h700.sh" ]; then
			log "running installer/updater"
			if sh "$SD/.tmp_update/h700.sh" >> "$LOG" 2>&1; then
				log "installer exited 0"
			else
				installer_status=$?
				log "installer exited $installer_status"
				important_splash -1 "INSTALL FAILED"
				INSTALL_FAILED=1
			fi
		else
			log "installer missing after bootstrap"
			important_splash -1 "INSTALL FAILED"
			INSTALL_FAILED=1
		fi
	fi
fi

# BaseOS-owned multi-frontend catalog. Metadata lives below .baseos;
# original frontend program directories are treated as read-only input.
FRONTEND_CATALOG_SELECTED=no
FRONTEND_PREFERENCE=auto
if [ -r "$SD/baseos.conf" ]; then
	while IFS= read -r frontend_config_line || [ -n "$frontend_config_line" ]; do
		case "$frontend_config_line" in
			frontend_id=*) FRONTEND_PREFERENCE=${frontend_config_line#frontend_id=} ;;
		esac
	done < "$SD/baseos.conf"
fi
[ -n "$FRONTEND_PREFERENCE" ] || FRONTEND_PREFERENCE=auto

# Either L1 or R1 opens the selector. MENU stays reserved for USB storage.
if [ ! -e /run/baseos-frontend-selector-boot-checked ]; then
	: > /run/baseos-frontend-selector-boot-checked
	if [ -x /usr/sbin/baseos-control-center ] &&
	   /usr/sbin/baseos-control-center --boot-held; then
		log "boot selector requested by L1/R1"
		: > /run/baseos-frontend-selector-shown
		BASEOS_FRONTEND_TF1=$SD BASEOS_FRONTEND_TF2=$SD \
			/usr/sbin/baseos-frontend-manager catalog >/dev/null 2>&1 || :
		rm -f /run/baseos-frontend-selection
		/usr/sbin/baseos-control-center --selector >/dev/null 2>&1 || \
			log "frontend selector UI returned an error"
		if [ -s /run/baseos-frontend-selection ]; then
			read -r FRONTEND_PREFERENCE < /run/baseos-frontend-selection || FRONTEND_PREFERENCE=auto
			rm -f /run/baseos-frontend-selection
			log "one-time frontend selection: $FRONTEND_PREFERENCE"
		else
			log "frontend selector closed without changing the one-boot selection"
		fi
	fi
fi

# Compatibility wrappers are BaseOS sidecars; no frontend files are rewritten.
if [ -x /usr/sbin/baseos-frontend-manager ] &&
   BASEOS_FRONTEND_TF1=$SD BASEOS_FRONTEND_TF2=$SD \
     /usr/sbin/baseos-frontend-manager catalog >/dev/null 2>&1; then
	FRONTEND_CATALOG=/run/baseos-frontend-catalog
	if [ -s "$FRONTEND_CATALOG" ]; then
		FRONTEND_BEST_PRIORITY=-1
		FRONTEND_BEST_LINE=
		while IFS='|' read -r candidate_id candidate_name candidate_package candidate_profile \
			candidate_root candidate_dir candidate_config candidate_priority candidate_kind candidate_status; do
			[ -n "$candidate_id" ] || continue
			[ "$candidate_status" = enabled ] || continue
			if [ "$FRONTEND_PREFERENCE" = auto ]; then
				if [ "$candidate_priority" -gt "$FRONTEND_BEST_PRIORITY" ] 2>/dev/null; then
					FRONTEND_BEST_PRIORITY=$candidate_priority
					FRONTEND_BEST_LINE="$candidate_id|$candidate_name|$candidate_package|$candidate_profile|$candidate_root|$candidate_dir|$candidate_config|$candidate_priority|$candidate_kind|$candidate_status"
				fi
			elif [ "$candidate_id" = "$FRONTEND_PREFERENCE" ]; then
				FRONTEND_BEST_LINE="$candidate_id|$candidate_name|$candidate_package|$candidate_profile|$candidate_root|$candidate_dir|$candidate_config|$candidate_priority|$candidate_kind|$candidate_status"
				break
			fi
		done < "$FRONTEND_CATALOG"

		if [ -z "$FRONTEND_BEST_LINE" ] && [ "$FRONTEND_PREFERENCE" != auto ]; then
			log "configured frontend_id '$FRONTEND_PREFERENCE' unavailable; falling back to automatic discovery"
			FRONTEND_PREFERENCE=auto
			FRONTEND_BEST_PRIORITY=-1
			while IFS='|' read -r candidate_id candidate_name candidate_package candidate_profile \
				candidate_root candidate_dir candidate_config candidate_priority candidate_kind candidate_status; do
				[ -n "$candidate_id" ] && [ "$candidate_status" = enabled ] || continue
				if [ "$candidate_priority" -gt "$FRONTEND_BEST_PRIORITY" ] 2>/dev/null; then
					FRONTEND_BEST_PRIORITY=$candidate_priority
					FRONTEND_BEST_LINE="$candidate_id|$candidate_name|$candidate_package|$candidate_profile|$candidate_root|$candidate_dir|$candidate_config|$candidate_priority|$candidate_kind|$candidate_status"
				fi
			done < "$FRONTEND_CATALOG"
		fi

		if [ -n "$FRONTEND_BEST_LINE" ]; then
			IFS='|' read -r SELECTED FRONTEND_NAME FRONTEND_PACKAGE_ID FRONTEND_PROFILE_ID \
				FRONTEND_CATALOG_ROOT FRONTEND_PACKAGE_DIR FRONTEND_PROFILE_DEFAULTS \
				FRONTEND_PRIORITY FRONTEND_CATALOG_KIND FRONTEND_CATALOG_STATUS <<EOF
$FRONTEND_BEST_LINE
EOF
			LAUNCH="$FRONTEND_PACKAGE_DIR/launch.sh"
			FRONTEND=baseos
			LAUNCH_TYPE=script
			FRONTEND_CATALOG_SELECTED=yes
			FRONTEND_PROGRAM_ROOT=$SD
			FRONTEND_PATHMAP_ID=$SELECTED
			FRONTEND_PACKAGE_MODE=no
			BASEOS_COMPAT_PROGRAM_DIR=

			. /usr/sbin/baseos-frontend-discovery
			case "$FRONTEND_CATALOG_KIND" in
				managed|compat)
					if baseos_frontend_load_package "$FRONTEND_CATALOG_ROOT" \
						"$FRONTEND_PACKAGE_DIR" "$FRONTEND_PROFILE_DEFAULTS"; then
						FRONTEND_PACKAGE_MODE=yes
						FRONTEND_PACKAGE_ID=$BASEOS_PACKAGE_ID
						FRONTEND_PROFILE_ID=$BASEOS_PROFILE_ID
						FRONTEND_PATHMAP_ID=$FRONTEND_PACKAGE_ID
						if [ "$FRONTEND_CATALOG_KIND" = compat ]; then
							FRONTEND_PROGRAM_ROOT=$BASEOS_COMPAT_PROGRAM_DIR
						else
							FRONTEND_PROGRAM_ROOT=$FRONTEND_PACKAGE_DIR
							[ ! -d "$FRONTEND_PROGRAM_ROOT/payload" ] || \
								FRONTEND_PROGRAM_ROOT=$FRONTEND_PROGRAM_ROOT/payload
						fi
					else
						log "catalog package metadata changed during discovery; ignoring the catalog entry"
						FRONTEND_CATALOG_SELECTED=no
						LAUNCH=
					fi
					;;
				legacy-adapter)
					case "$FRONTEND_PACKAGE_DIR" in
						"$SD"/Frontends/*/.baseos/frontends/*)
							FRONTEND_PROGRAM_ROOT=${FRONTEND_PACKAGE_DIR%%/.baseos/frontends/*}
							;;
						"$SD"/.baseos/frontends/*|"$SD"/baseos/frontends/*)
							FRONTEND_PROGRAM_ROOT=$SD
							;;
						*) FRONTEND_PROGRAM_ROOT=$SD ;;
					esac
					FRONTEND_PATHMAP_ID=$SELECTED
					;;
				*)
					log "unsupported frontend catalog kind '$FRONTEND_CATALOG_KIND'"
					FRONTEND_CATALOG_SELECTED=no
					LAUNCH=
					;;
			esac

			if [ "$FRONTEND_CATALOG_SELECTED" = yes ]; then
				BASEOS_FRONTEND_ID=$SELECTED
				BASEOS_FRONTEND_ROOT=$SD
				BASEOS_CARD_ROOT=$SD
				BASEOS_FRONTEND_PROGRAM_ROOT=$FRONTEND_PROGRAM_ROOT
				BASEOS_FRONTEND_PATHMAP_ID=$FRONTEND_PATHMAP_ID
				BASEOS_INSTANCE_ID=$SELECTED
				BASEOS_INSTANCE_DIR=$SD/.baseos/instances/$SELECTED
				BASEOS_DATA_DIR=$BASEOS_INSTANCE_DIR/data
				BASEOS_USERDATA_DIR=$BASEOS_INSTANCE_DIR/userdata
				BASEOS_PROFILE_CONFIG=$BASEOS_INSTANCE_DIR/config/profile.conf
				BASEOS_GAMES_DIR=$SD/Games
				BASEOS_SAVES_DIR=$SD/Saves
				BASEOS_BIOS_DIR=$SD/Bios
				BASEOS_CHEATS_DIR=$SD/Cheats
				BASEOS_OVERLAYS_DIR=$SD/Overlays
				BASEOS_SHADERS_DIR=$SD/Shaders
				mkdir -p "$SD/Games" "$SD/Saves" "$SD/Bios" "$SD/Cheats" \
					"$SD/Overlays" "$SD/Shaders" \
					"$BASEOS_INSTANCE_DIR/config" "$BASEOS_INSTANCE_DIR/cache" \
					"$BASEOS_INSTANCE_DIR/states" "$BASEOS_INSTANCE_DIR/database" \
					"$BASEOS_INSTANCE_DIR/assets" "$BASEOS_INSTANCE_DIR/logs" \
					"$BASEOS_DATA_DIR" "$BASEOS_USERDATA_DIR" 2>/dev/null || :
				if [ -n "$FRONTEND_PROFILE_DEFAULTS" ] && [ -f "$FRONTEND_PROFILE_DEFAULTS" ] &&
				   [ ! -s "$BASEOS_PROFILE_CONFIG" ]; then
					cp "$FRONTEND_PROFILE_DEFAULTS" "$BASEOS_PROFILE_CONFIG" 2>/dev/null || :
				fi
				BASEOS_PACKAGE_DIR=$FRONTEND_PACKAGE_DIR
				BASEOS_PROFILE_DEFAULTS=$FRONTEND_PROFILE_DEFAULTS
				BASEOS_LAUNCHER=$LAUNCH
				export BASEOS_FRONTEND_ID BASEOS_FRONTEND_ROOT BASEOS_CARD_ROOT
				export BASEOS_FRONTEND_PROGRAM_ROOT BASEOS_FRONTEND_PATHMAP_ID
				export BASEOS_INSTANCE_ID BASEOS_INSTANCE_DIR BASEOS_DATA_DIR BASEOS_USERDATA_DIR
				export BASEOS_PACKAGE_ID BASEOS_PROFILE_ID BASEOS_PACKAGE_DIR
				export BASEOS_PROFILE_CONFIG BASEOS_PROFILE_DEFAULTS BASEOS_COMPAT_PROGRAM_DIR
				export BASEOS_GAMES_DIR BASEOS_SAVES_DIR BASEOS_BIOS_DIR BASEOS_CHEATS_DIR
				export BASEOS_OVERLAYS_DIR BASEOS_SHADERS_DIR BASEOS_LAUNCHER

				if [ -x /usr/sbin/baseos-frontend-paths ] &&
				   /usr/sbin/baseos-frontend-paths scan "$SD" "$FRONTEND_PATHMAP_ID" \
						"$FRONTEND_PROGRAM_ROOT" >/dev/null 2>&1; then
					BASEOS_FRONTEND_PATHMAP=$SD/.baseos/frontend-paths/$FRONTEND_PATHMAP_ID.conf
					export BASEOS_FRONTEND_PATHMAP
					if /usr/sbin/baseos-frontend-paths apply "$SD" "$FRONTEND_PROGRAM_ROOT" \
						"$BASEOS_FRONTEND_PATHMAP" "$BASEOS_USERDATA_DIR" >/dev/null 2>&1; then
						log "shared Games/Saves and per-profile userdata paths applied for $SELECTED"
					else
						log "WARNING: frontend path map could not be applied for $SELECTED"
					fi
				fi
				log "selected BaseOS frontend profile $SELECTED ($FRONTEND_CATALOG_KIND, priority=$FRONTEND_PRIORITY)"
			fi
		fi
	fi
fi

LAUNCH=${LAUNCH:-}
FRONTEND=${FRONTEND:-}
LAUNCH_TYPE=${LAUNCH_TYPE:-script}
if [ -z "$LAUNCH" ]; then
	# Keep direct H700 entry points working for cards without a BaseOS manifest.
	if [ -f "$SD/System/frontend" ]; then
		LAUNCH="$SD/System/frontend"
		FRONTEND=generic
		LAUNCH_TYPE=binary
	elif [ -f "$SD/System/launch_frontend.sh" ]; then
		LAUNCH="$SD/System/launch_frontend.sh"
		FRONTEND=generic
	elif [ -f "$SD/System/slot" ]; then
		LAUNCH="$SD/System/slot"
		FRONTEND=slot
		LAUNCH_TYPE=binary
	elif [ -f "$SD/.system/h700/paks/MinUI.pak/launch.sh" ]; then
		LAUNCH="$SD/.system/h700/paks/MinUI.pak/launch.sh"
		FRONTEND=nextui
	elif [ -f "$SD/spruce/scripts/runtime.sh" ]; then
		LAUNCH="$SD/spruce/scripts/runtime.sh"
		FRONTEND=spruce
	fi
fi

if [ "$CARD_MISSING" -eq 0 ] && [ -f "$LAUNCH" ]; then
	if [ "$FRONTEND" = slot ]; then
		export SLOT_ROOT="$SD"
	fi
	if [ "$FRONTEND" = slot ] || [ "$FRONTEND" = generic ]; then
		cd "$SD" || exit 1
	fi
	# rcS loads mali_kbase in the background; make sure /dev/mali0 exists
	# before the frontend initializes graphics (near-always already true).
	m=0
	while [ ! -e /dev/mali0 ] && [ "$m" -lt 30 ]; do
		sleep 0.1 2>/dev/null || sleep 1
		m=$((m + 1))
	done
	# A plain name for the log: the pak's name (MinUI for NextUI's MinUI.pak),
	# else the frontend's own.
	case "$LAUNCH" in
		*/*.pak/*) frontend_name=${LAUNCH%.pak/*} frontend_name=${frontend_name##*/} ;;
		*)
			case "$FRONTEND" in
				slot) frontend_name=Slot ;;
				spruce) frontend_name=spruceOS ;;
				*) frontend_name="custom frontend" ;;
			esac ;;
	esac
	gpu_wait=
	[ "$m" -eq 0 ] || gpu_wait=", after $((m / 10)).$((m % 10)) s waiting for the GPU"
	# Keep the first handoff across respawns and record it in the readable log.
	if [ ! -s /run/boot-frontend-exec ]; then
		# boot-clock validates counter access/frequency at the first handoff.
		# Keep BOOTTIME for the existing marker/budget. The split in the log
		# uses the unadjusted clock so NTP cannot masquerade as boot work.
		boot_pre= boot_post= boot_total=
		if ! { [ -x /usr/sbin/boot-clock ] \
			&& /usr/sbin/boot-clock > /run/boot-clock-handoff 2>/dev/null \
			&& read -r boot_uptime boot_pre boot_post boot_total < /run/boot-clock-handoff; }; then
			boot_pre= boot_post= boot_total=
			read -r boot_uptime boot_idle < /proc/uptime || boot_uptime=
		fi
		[ -z "$boot_uptime" ] || printf '%s\n' "$boot_uptime" > /run/boot-frontend-exec 2>/dev/null || :
		if [ -n "$boot_total" ]; then
			log "Startup: $(seconds "$boot_pre") s before Linux, $(seconds "$boot_post") s Linux to menu, $(seconds "$boot_total") s total ($frontend_name$gpu_wait)"
		elif [ -n "$boot_uptime" ]; then
			log "Startup: $(seconds "$boot_uptime") s Linux to menu ($frontend_name$gpu_wait)"
		fi
		start_diagnostics
	else
		log "Frontend started again: $frontend_name$gpu_wait"
	fi
	# Managed/compat packages may expect their own program directory as cwd.
	if [ "$FRONTEND_CATALOG_SELECTED" = yes ]; then
		cd "$FRONTEND_PROGRAM_ROOT" || exit 1
	else
		cd "$SD" || exit 1
	fi
	frontend_log=/tmp/${SELECTED:-$FRONTEND}.log
	if [ "$LAUNCH_TYPE" = binary ]; then
		# Use the system glibc loader: copied binaries need no executable bit.
		/lib/ld-linux-aarch64.so.1 "$LAUNCH" > "$frontend_log" 2>&1
	elif [ "$FRONTEND" = generic ]; then
		/bin/sh "$LAUNCH" > "$frontend_log" 2>&1
	else
		/bin/sh "$LAUNCH" > "$frontend_log" 2>&1
	fi
	frontend_status=$?
	cd / 2>/dev/null || :
	if [ "$FRONTEND_CATALOG_SELECTED" = yes ] &&
	   [ -x /usr/sbin/baseos-frontend-paths ]; then
		/usr/sbin/baseos-frontend-paths cleanup "$SD" >/dev/null 2>&1 || \
			log "WARNING: frontend path aliases did not fully clean up"
	fi
	log "frontend $SELECTED exited with status $frontend_status; returning to diagnostics"
	if [ -x /usr/sbin/baseos-control-center ]; then
		BASEOS_FRONTEND_TF1=$SD BASEOS_FRONTEND_TF2=$SD \
			/usr/sbin/baseos-frontend-manager catalog >/dev/null 2>&1 || :
		/usr/sbin/baseos-control-center --diagnostics >/dev/null 2>&1 || :
	fi
	sleep 3
	exit 1
fi

# With no installed frontend, open the same selector once so the user can
# inspect diagnostics or install a compatible package without a keyboard.
if [ "$CARD_MISSING" -eq 0 ] && [ "$INSTALL_FAILED" -eq 0 ] &&
   [ ! -e /run/baseos-frontend-selector-shown ] &&
   [ -x /usr/sbin/baseos-control-center ]; then
	: > /run/baseos-frontend-selector-shown
	BASEOS_FRONTEND_TF1=$SD BASEOS_FRONTEND_TF2=$SD \
		/usr/sbin/baseos-frontend-manager catalog >/dev/null 2>&1 || :
	/usr/sbin/baseos-control-center --selector >/dev/null 2>&1 || :
fi
if [ "$CARD_MISSING" -eq 1 ]; then
	log "no card mounted — waiting for insertion"
elif [ "$INSTALL_FAILED" -eq 1 ]; then
	log "frontend install failed — waiting to retry"
else
	log "no frontend on card — waiting for the user to add one"
	important_splash -1 "ADD FRONTEND TO SD CARD"
fi
[ "$CARD_MISSING" -eq 1 ] || start_diagnostics
sleep 5
exit 1
