#!/bin/sh
# Generate BaseOS-owned compatibility packages for ordinary frontend folders.
# The frontend program directory is never modified.
set -eu
PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH
. "${BASEOS_DISCOVERY_LIB:-/usr/sbin/baseos-frontend-discovery}"

TF1=${BASEOS_FRONTEND_TF1:-/mnt/sdcard}
TF2=${BASEOS_FRONTEND_TF2:-$TF1}

normalise_id() {
  ni_raw=$1
  case "$ni_raw" in ''|*'|'*) return 1 ;; esac
  printf '%s' "$ni_raw" | LC_ALL=C grep -q '[[:cntrl:]]' && return 1
  ni_id=$(printf '%s' "$ni_raw" | LC_ALL=C tr -c 'A-Za-z0-9._-' '-' | tr -s '-')
  ni_id=$(printf '%s' "$ni_id" | sed 's/^[._-]*//; s/[._-]*$//; s/--*/-/g')
  if [ -z "$ni_id" ]; then
    # A folder name made entirely from non-ASCII characters still receives a
    # stable, readable-structure-safe ID; the original name remains its label.
    ni_hash=$(printf '%s' "$ni_raw" | cksum | awk '{print $1}')
    ni_id=frontend-$ni_hash
  fi
  if [ "${#ni_id}" -gt 22 ]; then
    ni_hash=$(printf '%s' "$ni_raw" | cksum | awk '{print $1}')
    ni_prefix=$(printf '%s' "$ni_id" | cut -c1-11)
    ni_id=$ni_prefix-$ni_hash
  fi
  baseos_frontend_valid_id "$ni_id" || return 1
  [ "${#ni_id}" -le 22 ] || return 1
  case "$ni_id" in *--*) return 1 ;; esac
  COMPAT_ID=$ni_id
  return 0
}

shell_quote() {
  printf "'"
  printf '%s' "$1" | sed "s/'/'\\\\''/g"
  printf "'"
}

write_if_changed() {
  wic_path=$1
  wic_tmp=$wic_path.tmp
  [ ! -L "$wic_path" ] || return 1
  [ ! -L "$wic_tmp" ] || return 1
  rm -f "$wic_tmp"
  cat > "$wic_tmp"
  if [ -f "$wic_path" ] && cmp -s "$wic_path" "$wic_tmp"; then
    rm -f "$wic_tmp"
  else
    mv -f "$wic_tmp" "$wic_path"
  fi
}

is_elf_file() {
  elf_magic=$(od -An -N4 -tx1 "$1" 2>/dev/null | tr -d '[:space:]')
  [ "$elf_magic" = 7f454c46 ]
}

# Some frontends (NextUI/MinUI) hard-code their runtime root to
# $SDCARD/.system/<platform> and never read anything from Frontends/<id>/, so
# they can only run from a card-root install. Shipping an archive lets the
# user drop the release zip in place; BaseOS expands it at the card root on
# first launch and removes it again on uninstall.
archive_card_payload() {
  acp_zip=$1
  acp_list=$(unzip -l "$acp_zip" 2>/dev/null | awk 'NF >= 4 { print $4 }')
  acp_platform=${BASEOS_PLATFORM:-}
  if [ -z "$acp_platform" ] && [ -r /etc/baseos-release ]; then
    acp_platform=$(sed -n 's/^BASEOS_PLATFORM=//p' /etc/baseos-release | tr -d '"' | head -n 1)
  fi
  acp_entry=
  # Release archives carry one branch per H700-family platform; only the one
  # matching this device is a runnable entry point.
  if [ -n "$acp_platform" ]; then
    acp_entry=$(printf '%s\n' "$acp_list" |
      grep -E "^\.system/$acp_platform/paks/[^/]+\.pak/launch\.sh$" |
      head -n 1)
  fi
  if [ -z "$acp_entry" ]; then
    acp_entry=$(printf '%s\n' "$acp_list" |
      grep -E '^\.system/[^/]+/paks/[^/]+\.pak/launch\.sh$' |
      head -n 1)
  fi
  [ -n "$acp_entry" ] || return 1
  CARD_PAYLOAD_ENTRYPOINT=$acp_entry
  return 0
}

# Record what the archive expanded to. Only frontend-private roots are listed,
# so uninstall can delete the payload without ever touching the shared
# Roms/Bios/Saves trees that live at the same level.
write_payload_manifest() {
  wpm_zip=$1 wpm_card=$2 wpm_id=$3 wpm_stat=$4 wpm_entry=$5
  wpm_dir=$wpm_card/.baseos/payload
  mkdir -p "$wpm_dir" || return 1
  [ ! -L "$wpm_dir" ] || return 1
  wpm_file=$wpm_dir/$wpm_id.conf
  [ ! -L "$wpm_file" ] || return 1
  wpm_tmp=$wpm_file.tmp
  rm -f "$wpm_tmp"
  {
    printf '%s\n' 'payload_api=1'
    printf 'archive=%s\n' "${wpm_zip##*/}"
    printf 'archive_stat=%s\n' "$wpm_stat"
    printf 'entrypoint=%s\n' "$wpm_entry"
    unzip -l "$wpm_zip" 2>/dev/null |
      awk 'NF >= 4 { print $4 }' |
      sed -n 's#^\([^/][^/]*\)/.*#\1#p' |
      sort -u |
      while IFS= read -r wpm_path; do
        case "$wpm_path" in
          .system|.tmp_update|Tools) printf 'path=%s\n' "$wpm_path" ;;
        esac
      done
  } > "$wpm_tmp" || return 1
  mv -f "$wpm_tmp" "$wpm_file"
}

# Expand only this device's platform branch plus the archive's other top-level
# trees. Release archives bundle every H700-family platform, and unpacking the
# unused ones triples the one-off install cost on a vfat card for no benefit.
expand_card_payload() {
  ecp_zip=$1 ecp_card=$2
  ecp_list=$(unzip -l "$ecp_zip" 2>/dev/null | awk 'NF >= 4 { print $4 }' | grep '/')
  ecp_platform=${BASEOS_PLATFORM:-}
  if [ -z "$ecp_platform" ] && [ -r /etc/baseos-release ]; then
    ecp_platform=$(sed -n 's/^BASEOS_PLATFORM=//p' /etc/baseos-release | tr -d '"' | head -n 1)
  fi
  ecp_wanted=$ecp_list
  if [ -n "$ecp_platform" ]; then
    ecp_others=$(printf '%s\n' "$ecp_list" |
      sed -n 's#^\.system/\([^/]*\)/paks/.*#\1#p' | sort -u |
      grep -v -x "$ecp_platform" | tr '\n' '|' | sed 's/|*$//')
    if [ -n "$ecp_others" ]; then
      ecp_wanted=$(printf '%s\n' "$ecp_list" | grep -v -E "^\.system/($ecp_others)/")
    fi
  fi
  # Unquoted on purpose: one archive member per argument. Release members never
  # contain whitespace at this level.
  # shellcheck disable=SC2086
  unzip -o -q "$ecp_zip" $ecp_wanted -d "$ecp_card"
}

# Discover by directory structure and launch contract, never frontend name.
resolve_entrypoint() {
  re_dir=$1
  COMPAT_ENTRY=
  COMPAT_MODE=

  for re_name in launch.sh start.sh run.sh frontend.sh .tmp_update/updater .tmp_update/launch.sh; do
    if [ -f "$re_dir/$re_name" ] && [ ! -L "$re_dir/$re_name" ]; then
      COMPAT_ENTRY=$re_name
      COMPAT_MODE=script-package
      return 0
    fi
  done

  # A card-root payload archive takes precedence over an already-unpacked
  # .system/ inside the package: the archive is what BaseOS knows how to
  # install and uninstall, and the inline copy would resolve its runtime to
  # the card root anyway.
  for re_path in "$re_dir"/*.zip; do
    [ -f "$re_path" ] && [ ! -L "$re_path" ] || continue
    archive_card_payload "$re_path" || continue
    COMPAT_ENTRY=${re_path#"$re_dir"/}
    COMPAT_MODE=zip-card
    return 0
  done

  for re_path in "$re_dir"/.system/h700/paks/*.pak/launch.sh; do
    [ -f "$re_path" ] && [ ! -L "$re_path" ] || continue
    COMPAT_ENTRY=${re_path#"$re_dir"/}
    COMPAT_MODE=script-pak
    return 0
  done

  for re_path in "$re_dir"/*/scripts/runtime.sh; do
    [ -f "$re_path" ] && [ ! -L "$re_path" ] || continue
    COMPAT_ENTRY=${re_path#"$re_dir"/}
    COMPAT_MODE=script-runtime
    return 0
  done

  if [ -f "$re_dir/System/launch_frontend.sh" ] &&
     [ ! -L "$re_dir/System/launch_frontend.sh" ]; then
    COMPAT_ENTRY=System/launch_frontend.sh
    COMPAT_MODE=script-card
    return 0
  fi

  # H700 legacy frontend contract: the primary card-root executable has
  # an explicit, stable name. Never select an arbitrary ELF from System/,
  # where opening animations and libretro cores may appear before the UI.
  for re_name in System/slot System/frontend; do
    re_path=$re_dir/$re_name
    [ -f "$re_path" ] && [ ! -L "$re_path" ] || continue
    if is_elf_file "$re_path"; then
      COMPAT_ENTRY=$re_name
      COMPAT_MODE=binary-card
      return 0
    fi
  done
  return 1
}

launch_compat() {
  lc_root=$1 lc_entry=$2 lc_mode=$3
  case "$lc_entry" in
    ''|/*|*'..'*|*'|'*|*[!A-Za-z0-9._/-]*) return 126 ;;
  esac
  [ -f "$lc_root/$lc_entry" ] && [ ! -L "$lc_root/$lc_entry" ] || return 126
  lc_card=${BASEOS_CARD_ROOT:-$lc_root}
  lc_target=$lc_root/$lc_entry
  case "$lc_mode" in
    script-package)
      cd "$lc_root" || return 126
      exec /bin/sh "$lc_target"
      ;;
    script-pak)
      cd "$(dirname "$lc_target")" || return 126
      exec /bin/sh "$lc_target"
      ;;
    script-card)
      cd "$lc_card" || return 126
      exec /bin/sh "$lc_target"
      ;;
    script-runtime)
      export ROMS_PATH="$lc_card/Roms/"
      if [ -n "${BASEOS_FAVORITES_DIR:-}" ]; then
        export FAVORITES_PATH="$BASEOS_FAVORITES_DIR/pyui-favorites.json"
      fi
      if [ -n "${BASEOS_RECENTS_DIR:-}" ]; then
        export RECENTS_PATH="$BASEOS_RECENTS_DIR/pyui-recents.json"
      fi
      if [ -n "${BASEOS_CONFIG_DIR:-}" ]; then
        export APPS_CONFIG_PATH="$BASEOS_CONFIG_DIR/pyui-apps.json"
        export COLLECTIONS_PATH="$BASEOS_CONFIG_DIR/collections/"
        export STATE_PATH="$BASEOS_CONFIG_DIR/pyui-state.json"
        mkdir -p "$BASEOS_CONFIG_DIR/collections"
      fi
      cd "$lc_card" || return 126
      exec /bin/sh "$lc_target"
      ;;
    binary-card)
      # Keep the historical card-root alias for existing H700 binary payloads.
      BASEOS_CARD_ROOT=$lc_card SLOT_ROOT=$lc_card
      export BASEOS_CARD_ROOT SLOT_ROOT
      cd "$lc_card" || return 126
      exec /lib/ld-linux-aarch64.so.1 "$lc_target"
      ;;
    binary-package)
      cd "$lc_root" || return 126
      exec /lib/ld-linux-aarch64.so.1 "$lc_target"
      ;;
    zip-card)
      lc_zip=$lc_target
      lc_payload_id=${BASEOS_PACKAGE_ID:-}
      if [ -z "$lc_payload_id" ]; then
        lc_payload_id=$(printf '%s' "${lc_root##*/}" | LC_ALL=C tr -c 'A-Za-z0-9._-' '-' | tr -s '-')
      fi
      case "$lc_payload_id" in ''|.|..|*/*|*'|'*) return 126 ;; esac
      lc_payload_dir=$lc_card/.baseos/payload
      [ ! -L "$lc_payload_dir" ] || return 126
      lc_marker=$lc_payload_dir/$lc_payload_id.conf
      lc_stat=$(stat -c '%Y:%s' "$lc_zip" 2>/dev/null || echo unknown)
      if [ ! -f "$lc_marker" ] || [ -L "$lc_marker" ] ||
         ! grep -qx "archive_stat=$lc_stat" "$lc_marker" 2>/dev/null; then
        # First run, or the user replaced the release archive.
        echo "baseos: installing ${lc_zip##*/} at the card root (one-off)" >&2
        expand_card_payload "$lc_zip" "$lc_card" || return 126
        archive_card_payload "$lc_zip" || return 126
        write_payload_manifest "$lc_zip" "$lc_card" "$lc_payload_id" "$lc_stat" \
          "$CARD_PAYLOAD_ENTRYPOINT" || return 126
      fi
      lc_pak=$(sed -n 's/^entrypoint=//p' "$lc_marker" 2>/dev/null | head -n 1)
      [ -n "$lc_pak" ] || return 126
      case "$lc_pak" in /*|*..*|*'|'*) return 126 ;; esac
      lc_pak_path=$lc_card/$lc_pak
      [ -f "$lc_pak_path" ] && [ ! -L "$lc_pak_path" ] || return 126
      # Card-root frontends detect their model from /mnt/vendor/bin/dmenu.bin,
      # which BaseOS replaces with a stub. Hand the platform model over so they
      # do not fall back to a generic key layout and panel geometry.
      if [ -z "${RGXX_MODEL:-}" ] && [ -r /etc/baseos-release ]; then
        lc_model=$(sed -n 's/^BASEOS_MODEL_STRING=//p' /etc/baseos-release | tr -d '"' | head -n 1)
        if [ -n "$lc_model" ]; then
          RGXX_MODEL=$lc_model
          export RGXX_MODEL
        fi
      fi
      cd "$(dirname "$lc_pak_path")" || return 126
      exec /bin/sh "$lc_pak_path"
      ;;
    *)
      echo "unsupported compatibility launch mode: $lc_mode" >&2
      return 126
      ;;
  esac
}

compat_needs_scan() {
  cns_root=$1
  cns_state=$cns_root/.baseos/compat.scan-state
  [ -f "$cns_state" ] && [ ! -L "$cns_state" ] || return 0
  # Force one rescan after upgrading to the explicit H700 entrypoint contract,
  # discovering H700-specific entrypoints without relying on directory mtimes.
  [ "$(cat "$cns_state" 2>/dev/null)" = "frontend-compat-api=5" ] || return 0
  if [ -d "$cns_root/Frontends" ]; then
    [ "$cns_root/Frontends" -nt "$cns_state" ] && return 0
    for cns_dir in "$cns_root"/Frontends/*; do
      [ -d "$cns_dir" ] || continue
      [ "$cns_dir" -nt "$cns_state" ] && return 0
    done
  fi
  cns_disabled=$cns_root/.baseos/compat-disabled
  [ -d "$cns_disabled" ] && [ "$cns_disabled" -nt "$cns_state" ] && return 0
  # Removing/renaming the original source or its selected entry point does not
  # change the Frontends parent directory for nested updater paths. Check the
  # small generated manifest set using shell builtins and only rescan if stale.
  for cns_manifest in "$cns_root/.baseos/compat"/*/baseos-frontend.conf; do
    [ -f "$cns_manifest" ] || continue
    baseos_frontend_read_value "$cns_manifest" compat_source ""
    cns_source=$BASEOS_VALUE
    baseos_frontend_read_value "$cns_manifest" compat_entrypoint ""
    cns_entry=$BASEOS_VALUE
    [ -n "$cns_source" ] && [ -n "$cns_entry" ] || return 0
    case "$cns_source" in ''|.|..|*/*|*'|'*) return 0 ;; esac
    case "$cns_entry" in
      ''|/*|*'..'*|*'|'*|*[!A-Za-z0-9._/-]*) return 0 ;;
    esac
    [ -f "$cns_root/Frontends/$cns_source/$cns_entry" ] || return 0
    baseos_frontend_read_value "$cns_manifest" compat_entrypoint_stat ""
    cns_expected_stat=$BASEOS_VALUE
    cns_actual_stat=$(stat -c '%Y:%s' "$cns_root/Frontends/$cns_source/$cns_entry" 2>/dev/null || echo unknown)
    [ "$cns_actual_stat" = "$cns_expected_stat" ] || return 0
  done
  return 1
}

scan_root() {
  sr_root=$1
  [ -d "$sr_root/Frontends" ] && [ ! -L "$sr_root/Frontends" ] || return 0
  [ ! -L "$sr_root/.baseos" ] || return 0
  [ ! -L "$sr_root/.baseos/compat" ] || return 0
  compat_needs_scan "$sr_root" || return 0
  for sr_dir in "$sr_root"/Frontends/*; do
    [ -d "$sr_dir" ] && [ ! -L "$sr_dir" ] || continue
    [ -f "$sr_dir/baseos-frontend.conf" ] && continue
    resolve_entrypoint "$sr_dir" || continue
    sr_name=${sr_dir##*/}
    case "$sr_name" in .*|.|..) continue ;; esac
    normalise_id "$sr_name" || continue
    sr_id=$COMPAT_ID
    sr_display_name=$sr_name
    sr_display_bytes=$(printf '%s' "$sr_display_name" | wc -c | tr -d ' ')
    [ "$sr_display_bytes" -le 120 ] || sr_display_name=$sr_id
    # Keep generating/updating the sidecar while disabled. The runtime
    # discovery helper filters it using the tombstone; the selector needs the
    # preserved manifest to render an Enable action without rebuilding guesses.
    sr_disabled=$sr_root/.baseos/compat-disabled/$sr_id
    sr_sidecar=$sr_root/.baseos/compat/$sr_id
    if [ -e "$sr_sidecar" ] && [ ! -d "$sr_sidecar" ]; then
      echo "compat: refusing non-directory sidecar $sr_sidecar" >&2
      continue
    fi
    [ ! -L "$sr_sidecar" ] || continue
    sr_manifest=$sr_sidecar/baseos-frontend.conf
    if [ -r "$sr_manifest" ]; then
      baseos_frontend_read_value "$sr_manifest" compat_source ""
      if [ -n "$BASEOS_VALUE" ] && [ "$BASEOS_VALUE" != "$sr_name" ]; then
        echo "compat: ID collision for $sr_name ($sr_id already maps to $BASEOS_VALUE)" >&2
        continue
      fi
    fi
    [ ! -L "$sr_sidecar/profiles" ] || continue
    [ ! -L "$sr_manifest" ] || continue
    [ ! -L "$sr_sidecar/launch.sh" ] || continue
    [ ! -L "$sr_sidecar/profiles/default.conf" ] || continue
    mkdir -p "$sr_sidecar/profiles" || continue
    sr_program_quote=$(shell_quote "$sr_dir")
    sr_entry_quote=$(shell_quote "$COMPAT_ENTRY")
    sr_mode_quote=$(shell_quote "$COMPAT_MODE")
    sr_tool_quote=$(shell_quote "${BASEOS_COMPAT_TOOL:-/usr/sbin/baseos-frontend-compat}")
    sr_discovery_quote=$(shell_quote "${BASEOS_DISCOVERY_LIB:-/usr/sbin/baseos-frontend-discovery}")
    sr_stat=$(stat -c '%Y:%s' "$sr_dir/$COMPAT_ENTRY" 2>/dev/null || echo unknown)
    {
      printf '%s\n' 'package_api=1'
      printf 'display_name=%s\n' "$sr_display_name"
      printf '%s\n' 'compat_api=1'
      printf 'compat_source=%s\n' "$sr_name"
      printf 'compat_entrypoint=%s\n' "$COMPAT_ENTRY"
      printf 'compat_mode=%s\n' "$COMPAT_MODE"
      printf 'compat_entrypoint_stat=%s\n' "$sr_stat"
      printf '%s\n' 'priority=100' 'volume_owner=system' 'power_owner=system'
    } | write_if_changed "$sr_manifest"
    {
      printf '%s\n' '#!/bin/sh' 'set -eu'
      printf 'BASEOS_COMPAT_PROGRAM_DIR=%s\n' "$sr_program_quote"
      printf 'BASEOS_COMPAT_ENTRYPOINT=%s\n' "$sr_entry_quote"
      printf 'BASEOS_COMPAT_MODE=%s\n' "$sr_mode_quote"
      printf 'BASEOS_COMPAT_TOOL=%s\n' "$sr_tool_quote"
      printf 'BASEOS_DISCOVERY_LIB=%s\n' "$sr_discovery_quote"
      printf '%s\n' 'export BASEOS_COMPAT_PROGRAM_DIR'
      printf '%s\n' 'export BASEOS_COMPAT_TOOL BASEOS_DISCOVERY_LIB'
      printf 'cd "$BASEOS_COMPAT_PROGRAM_DIR"\n'
      printf '%s\n' 'exec "$BASEOS_COMPAT_TOOL" launch "$BASEOS_COMPAT_PROGRAM_DIR" "$BASEOS_COMPAT_ENTRYPOINT" "$BASEOS_COMPAT_MODE"'
    } | write_if_changed "$sr_sidecar/launch.sh"
    {
      printf '%s\n' 'profile_api=1'
      printf 'display_name=%s\n' "$sr_display_name"
      printf '%s\n' 'priority=100'
    } | write_if_changed "$sr_sidecar/profiles/default.conf"
  done
  # The common boot path only does directory mtime checks and reads the small
  # sidecar manifest set. Full name normalisation and wrapper regeneration run
  # only when a frontend folder is added/removed/changed.
  if [ ! -d "$sr_root/.baseos" ]; then
    mkdir -p "$sr_root/.baseos" || return 0
  fi
  state=$sr_root/.baseos/compat.scan-state
  [ ! -L "$state" ] || return 0
  printf '%s\n' 'frontend-compat-api=5' > "$state" 2>/dev/null || :
}

case "${1:-scan}" in
  scan)
    shift || :
    if [ "$#" -eq 0 ]; then set -- "$TF2" "$TF1"; fi
    for root in "$@"; do scan_root "$root"; done
    ;;
  probe)
    [ "$#" -eq 2 ] || exit 2
    if resolve_entrypoint "$2"; then
      printf '%s|%s\n' "$COMPAT_ENTRY" "$COMPAT_MODE"
    else
      exit 1
    fi
    ;;
  launch)
    [ "$#" -eq 4 ] || exit 2
    launch_compat "$2" "$3" "$4"
    ;;
  *)
    echo "usage: baseos-frontend-compat [scan [TF2_ROOT TF1_ROOT] | probe ROOT | launch ROOT ENTRY MODE]" >&2
    exit 2
    ;;
esac
